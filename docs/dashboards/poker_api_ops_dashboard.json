{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "table",
      "title": "Count by operation (sessions/hands)",
      "id": 1,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (path, method)(increase(app_http_requests_total{path=~\"$op_path\", method=~\"$op_method\"}[$__range])))",
          "legendFormat": "{{path}} {{method}}",
          "instant": true
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "align": "auto" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "table",
      "title": "Non-2xx error rate by operation (%)",
      "id": 2,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (path,method)(rate(app_http_requests_total{path=~\"$op_path\",method=~\"$op_method\",status_code!~\"2..\"}[$__rate_interval])) / clamp_min(sum by (path,method)(rate(app_http_requests_total{path=~\"$op_path\",method=~\"$op_method\"}[$__rate_interval])), 1)",
          "legendFormat": "{{path}} {{method}}",
          "instant": true
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "table",
      "title": "5xx error rate by operation (%)",
      "id": 3,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum by (path,method)(rate(app_http_errors_total{path=~\"$op_path\",method=~\"$op_method\"}[$__rate_interval])) / clamp_min(sum by (path,method)(rate(app_http_requests_total{path=~\"$op_path\",method=~\"$op_method\"}[$__rate_interval])), 1)) or on() vector(0)",
          "legendFormat": "{{path}} {{method}}",
          "instant": true
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "QPS by operation",
      "id": 4,
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path,method)(rate(app_http_requests_total{path=~\"$op_path\", method=~\"$op_method\"}[$__rate_interval]))",
          "legendFormat": "{{path}} {{method}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "req/s" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right" } },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["poker", "api", "sessions", "hands"],
  "templating": {
    "list": [
      {
        "name": "op_path",
        "label": "Path",
        "type": "query",
        "hide": 0,
        "datasource": "${DS_PROMETHEUS}",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "definition": "label_values(app_http_requests_total{path=~\"/sessions|/session|/hands|/hand\",method=~\"POST|PUT|DELETE\"}, path)",
        "query": "label_values(app_http_requests_total{path=~\"/sessions|/session|/hands|/hand\",method=~\"POST|PUT|DELETE\"}, path)",
        "options": [],
        "current": {}
      },
      {
        "name": "op_method",
        "label": "Method",
        "type": "query",
        "hide": 0,
        "datasource": "${DS_PROMETHEUS}",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": "POST|PUT|DELETE",
        "definition": "label_values(app_http_requests_total{path=~\"/sessions|/session|/hands|/hand\"}, method)",
        "query": "label_values(app_http_requests_total{path=~\"/sessions|/session|/hands|/hand\"}, method)",
        "options": [],
        "current": {}
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Poker API Ops (Sessions/Hands) - Count & Error Rate",
  "version": 4
}
